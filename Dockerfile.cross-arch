# Cross-architecture build & test for LunaLink C++ core.
# Usage: docker buildx build --platform linux/arm64 --progress=plain -f Dockerfile.cross-arch .
#
# Targets: linux/arm64 (LE, strict alignment)
#          linux/s390x (BE, strict alignment — endianness validation)
#          linux/riscv64 (LE — the flight target ISA, PolarFire SoC is RV64GC)
#
# Tests run inside RUN directives — build success = tests pass.
#
# Three named stages, because the workflow caches layers and a cache hit on a
# RUN that contains an assertion is a gate that passes without checking
# anything:
#
#   toolchain — apt only. Cacheable, and the point of caching: installing a
#               C++ toolchain under QEMU is pure emulated dpkg work that is
#               identical on every run.
#   build     — COPY + compile. Cacheable and correctly keyed: COPY invalidates
#               on any context change, so changed code always recompiles.
#   verify    — the test runs, and ONLY the test runs. cross-arch.yml names
#               this stage in --no-cache-filter so these RUNs execute on every
#               invocation, cache or no cache. Keep assertions in this stage
#               and nothing else, or the gate stops being one.

FROM ubuntu:24.04 AS toolchain

# Avoid interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    cmake \
    ninja-build \
    git \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM toolchain AS build

WORKDIR /src
COPY . .

# --- Build C++ core + unit tests + SWIFI tests ---
# LUNALINK_FAULT_INJECTION: redundant (BUILD_TESTING implies it), but explicit
# to self-document that SWIFI fault-injection tests are part of the cross-arch gate.
RUN cmake -B build -S . -G Ninja \
    -DBUILD_PYTHON_BINDINGS=OFF \
    -DBUILD_TESTING=ON \
    -DCMAKE_BUILD_TYPE=Debug \
    -DLUNALINK_FAULT_INJECTION=ON \
    && cmake --build build --parallel

FROM build AS verify

# --- Run unit tests ---
# Excluded by name, not by [slow]: this gate deliberately keeps the slow
# CORRECTNESS tests, so it cannot just filter ~[slow] the way test-cpp does.
#   [wcet] [channel] [e2e]  — timing and channel simulation, meaningless under
#                             emulation.
#   [fft_bench]             — the FFT timing grid, likewise, and it was the
#                             costliest single item in this job: 6.2 s of CPU
#                             natively in Release, including a 10-thread phase,
#                             on a 4-core runner under QEMU in Debug. Its
#                             impulse-response checks are now a separate [fft]
#                             test case and still run here, which is the part
#                             that matters on big-endian s390x.
RUN ./build/test_lunalink "~[wcet]~[channel]~[e2e]~[fft_bench]" --reporter console

# --- Run SWIFI fault-injection tests (fault detection correctness is arch-relevant) ---
RUN ./build/lunalink_swifi_tests --reporter console

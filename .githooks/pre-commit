#!/bin/bash
#
# Pre-commit hook for lunalink.
# Source of truth for checks is Taskfile.yml.
#

set -e

echo "Running pre-commit checks via Taskfile..."
echo ""

if ! task pre-commit; then
  echo ""
  echo "Pre-commit checks failed. Run 'task pre-commit' to reproduce."
  echo "For full CI checks (tidy, sanitizers, docs): task ci-checks"
  exit 1
fi

echo ""
echo "All pre-commit checks passed."
